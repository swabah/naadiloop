# Pooled Neon connection used by the running application.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/naadi

# Direct Neon connection used only by Drizzle schema operations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

PORT=3001
VITE_API_URL=http://localhost:3001/trpc
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Used by the database seed to create or refresh the Super Admin account.
SUPER_ADMIN_EMAIL=superadmin@naadi.demo
SUPER_ADMIN_PASSWORD=replace-with-a-strong-demo-password

# Server-only credential used by packages/ai. Never expose this as a VITE_ variable.
GEMINI_API_KEY=your-gemini-api-key

# Extraction defaults to a low-latency structured-output model when omitted.
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
